<Window x:Class="gironWin.ResearchNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x1F52C; &#x7814;&#x7A76;&#x30CE;&#x30FC;&#x30C8;" Height="560" Width="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- &#x30D5;&#x30A3;&#x30EB;&#x30BF;&#x30D0;&#x30FC; -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="&#x30D5;&#x30A3;&#x30EB;&#x30BF;: " VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="TagFilterCombo" Width="160"
                      SelectionChanged="TagFilterCombo_SelectionChanged">
                <ComboBoxItem Content="&#x3059;&#x3079;&#x3066;" IsSelected="True"/>
                <ComboBoxItem Content="Proposition"/>
                <ComboBoxItem Content="Definition"/>
                <ComboBoxItem Content="Assumption"/>
                <ComboBoxItem Content="ProofIdea"/>
                <ComboBoxItem Content="LemmaCandidate"/>
                <ComboBoxItem Content="Counterexample"/>
                <ComboBoxItem Content="Gap"/>
                <ComboBoxItem Content="Unverified"/>
                <ComboBoxItem Content="Derived"/>
            </ComboBox>
            <TextBlock x:Name="CountLabel" Margin="12,0,0,0"
                       VerticalAlignment="Center" Foreground="#666"/>
        </WrapPanel>

        <!-- &#x30BF;&#x30B0;&#x4E00;&#x89A7; -->
        <DataGrid Grid.Row="1" x:Name="TagGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  BorderBrush="#DDD" BorderThickness="1"
                  RowBackground="White"
                  AlternatingRowBackground="#FAFAFA">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Turn"    Binding="{Binding TurnNumber}" Width="55"/>
                <DataGridTextColumn Header="&#x30BF;&#x30B0;"   Binding="{Binding TagType}"    Width="120"/>
                <DataGridTextColumn Header="&#x5185;&#x5BB9;"   Binding="{Binding Content}"    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- &#x30DC;&#x30BF;&#x30F3; -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="&#x1F4CB; Markdown&#x30B3;&#x30D4;&#x30FC;" Width="150"
                    Margin="0,0,8,0" Click="CopyMarkdownButton_Click"/>
            <Button Content="&#x9589;&#x3058;&#x308B;" Width="80"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
