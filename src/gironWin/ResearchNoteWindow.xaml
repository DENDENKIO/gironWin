<Window x:Class="gironWin.ResearchNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="研究ノート" Height="620" Width="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- フィルターバー -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="タグ種別:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="TagFilterCombo" Width="200"
                      SelectionChanged="Filter_Changed" Margin="0,0,8,0">
                <ComboBoxItem Content="すべて" IsSelected="True"/>
                <ComboBoxItem Content="Proposition"/>
                <ComboBoxItem Content="Definition"/>
                <ComboBoxItem Content="Assumption"/>
                <ComboBoxItem Content="ProofIdea"/>
                <ComboBoxItem Content="LemmaCandidate"/>
                <ComboBoxItem Content="Counterexample"/>
                <ComboBoxItem Content="Gap"/>
                <ComboBoxItem Content="Unverified"/>
                <ComboBoxItem Content="Derived"/>
                <ComboBoxItem Content="OpenQuestion"/>
                <ComboBoxItem Content="Rigor"/>
                <ComboBoxItem Content="Agreement"/>
                <ComboBoxItem Content="Disagreement"/>
            </ComboBox>

            <TextBlock Text="重要度:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ImportanceFilterCombo" Width="100"
                      SelectionChanged="Filter_Changed" Margin="0,0,8,0">
                <ComboBoxItem Content="すべて" IsSelected="True"/>
                <ComboBoxItem Content="🔴 高"/>
                <ComboBoxItem Content="🟡 中"/>
                <ComboBoxItem Content="⚪ 低"/>
            </ComboBox>

            <TextBlock x:Name="CountLabel" VerticalAlignment="Center"
                       Foreground="#555" Margin="8,0,0,0"/>
        </WrapPanel>

        <!-- タグ一覧 -->
        <DataGrid x:Name="TagGrid" Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  AlternatingRowBackground="#F5F5F5"
                  SelectionMode="Single"
                  Margin="0,0,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Turn" Binding="{Binding TurnNumber}"   Width="48"/>
                <DataGridTextColumn Header="タグ"  Binding="{Binding DisplayTag}"   Width="160"/>
                <DataGridTextColumn Header="重要度" Binding="{Binding ImportanceLabel}" Width="64"/>
                <DataGridTextColumn Header="抽出テキスト" Binding="{Binding Text}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 詳細 + ボタン -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="選択エントリー詳細" Grid.Column="0" Margin="0,0,8,0">
                <TextBox x:Name="DetailBox" IsReadOnly="True" TextWrapping="Wrap"
                         MaxHeight="80" VerticalScrollBarVisibility="Auto"
                         Padding="4" Background="#FAFAFA"/>
            </GroupBox>

            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Bottom">
                <Button Content="📋 コピー" Width="100" Click="CopyButton_Click" Padding="6,3" Margin="0,0,0,6"/>
                <Button Content="閉じる"    Width="100" Click="CloseButton_Click" Padding="6,3"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
