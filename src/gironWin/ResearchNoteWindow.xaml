<Window x:Class="gironWin.ResearchNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="研究ノート" Height="600" Width="800"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="研究ノート" FontSize="16" FontWeight="Bold" Margin="0,0,16,0"/>
            <CheckBox x:Name="ShowUnverifiedOnlyCheckBox" Content="未検証のみ表示"
                      VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBox x:Name="NoteTextBox" IsReadOnly="True"
                     TextWrapping="Wrap" BorderThickness="0"
                     Background="#FAFAFA" FontSize="12" FontFamily="Consolas"
                     VerticalScrollBarVisibility="Auto"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Markdownコピー" Width="130" Margin="0,0,8,0"
                    Click="CopyButton_Click"/>
            <Button Content="閉じる" Width="90"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
