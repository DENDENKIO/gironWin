<Window x:Class="gironWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AI討論ワークベンチ"
        Width="1400" Height="900"
        MinWidth="900" MinHeight="600">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- Row 0: ナビゲーションバー -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Margin="8,8,8,4">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 左 URL -->
                <TextBox x:Name="LeftUrlTextBox"
                         Width="280" Margin="0,0,4,4"
                         VerticalContentAlignment="Center"
                         Text="https://www.perplexity.ai/" />
                <Button x:Name="LeftGoButton"
                        Width="70" Margin="0,0,8,4"
                        Content="左移動"
                        Click="LeftGoButton_Click" />

                <!-- 右 URL -->
                <TextBox x:Name="RightUrlTextBox"
                         Width="280" Margin="0,0,4,4"
                         VerticalContentAlignment="Center"
                         Text="https://gemini.google.com/app?hl=ja" />
                <Button x:Name="RightGoButton"
                        Width="70" Margin="0,0,16,4"
                        Content="右移動"
                        Click="RightGoButton_Click" />

                <!-- 転送オプション -->
                <CheckBox x:Name="AppendBridgeCheckBox"
                          Margin="0,0,12,4"
                          VerticalAlignment="Center"
                          IsChecked="True"
                          Content="橋渡し文" />
                <CheckBox x:Name="ConfirmBeforeSendCheckBox"
                          Margin="0,0,12,4"
                          VerticalAlignment="Center"
                          IsChecked="False"
                          Content="送信前確認" />

                <!-- 転送ボタン -->
                <Button x:Name="SendLeftSelectionToRightInputButton"
                        Width="130" Margin="0,0,4,4"
                        Content="左選択→右 入力"
                        Click="SendLeftSelectionToRightInputButton_Click" />
                <Button x:Name="SendLeftSelectionToRightSubmitButton"
                        Width="130" Margin="0,0,8,4"
                        Content="左選択→右 送信"
                        Click="SendLeftSelectionToRightSubmitButton_Click" />

                <Button x:Name="SendRightSelectionToLeftInputButton"
                        Width="130" Margin="0,0,4,4"
                        Content="右選択→左 入力"
                        Click="SendRightSelectionToLeftInputButton_Click" />
                <Button x:Name="SendRightSelectionToLeftSubmitButton"
                        Width="130" Margin="0,0,0,4"
                        Content="右選択→左 送信"
                        Click="SendRightSelectionToLeftSubmitButton_Click" />
            </WrapPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- Row 1: 自動討論コントロールバー -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Margin="8,0,8,4">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 自動討論 -->
                <TextBlock Text="自動討論:" Margin="0,0,6,4" VerticalAlignment="Center"
                           FontWeight="Bold" />
                <Button x:Name="StartAutoDebateButton"
                        Width="80" Margin="0,0,4,4"
                        Content="開始"
                        Click="StartAutoDebateButton_Click" />
                <Button x:Name="StopAutoDebateButton"
                        Width="80" Margin="0,0,4,4"
                        Content="停止" IsEnabled="False"
                        Click="StopAutoDebateButton_Click" />
                <Button x:Name="PauseResumeButton"
                        Width="80" Margin="0,0,8,4"
                        Content="一時停止" IsEnabled="False"
                        Click="PauseResumeButton_Click" />

                <!-- ターン数 -->
                <TextBlock Text="最大ターン:" Margin="0,0,4,4" VerticalAlignment="Center" />
                <TextBox x:Name="MaxTurnsTextBox"
                         Width="50" Margin="0,0,16,4"
                         VerticalContentAlignment="Center"
                         Text="0"
                         ToolTip="0=無制限" />

                <!-- ターン表示 -->
                <TextBlock x:Name="TurnCountTextBlock"
                           Text="ターン: 0"
                           Margin="0,0,16,4"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />

                <!-- 区切り -->
                <Separator Width="1" Height="20" Margin="0,0,16,4" />

                <!-- エクスポートボタン -->
                <TextBlock Text="エクスポート:" Margin="0,0,6,4" VerticalAlignment="Center"
                           FontWeight="Bold" />
                <Button x:Name="ExportMarkdownButton"
                        Width="110" Margin="0,0,4,4"
                        Content="Markdown 保存"
                        Click="ExportMarkdownButton_Click"
                        ToolTip="現セッションを .md ファイルに保存してフォルダを開きます" />
                <Button x:Name="ExportJsonButton"
                        Width="100" Margin="0,0,4,4"
                        Content="JSON 保存"
                        Click="ExportJsonButton_Click"
                        ToolTip="現セッションを .json ファイルに保存してフォルダを開きます" />
                <Button x:Name="OpenSessionFolderButton"
                        Width="120" Margin="0,0,0,4"
                        Content="フォルダを開く"
                        Click="OpenSessionFolderButton_Click"
                        ToolTip="セッション保存フォルダをエクスプローラーで開きます" />
            </WrapPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- Row 2: メインコンテンツ（WebView 2つ + 履歴パネル） -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="300" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- 左 WebView -->
            <wv2:WebView2 x:Name="LeftWebView" Grid.Column="0" />

            <GridSplitter Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#DDDDDD" />

            <!-- 右 WebView -->
            <wv2:WebView2 x:Name="RightWebView" Grid.Column="2" />

            <GridSplitter Grid.Column="3" Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#DDDDDD" />

            <!-- 右サイドパネル: 転送履歴 -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4,4,4">
                    <TextBlock Text="転送履歴" FontWeight="Bold" VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Button x:Name="ClearHistoryButton"
                            Content="クリア" Width="60"
                            Click="ClearHistoryButton_Click" />
                </StackPanel>

                <ListView x:Name="TransferHistoryListView"
                          Grid.Row="1"
                          ItemsSource="{Binding TransferRecords}"
                          MouseDoubleClick="TransferHistoryListView_MouseDoubleClick"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="テキストをコピー"
                                      Click="CopySelectedHistoryTextMenuItem_Click" />
                            <MenuItem Header="詳細を開く"
                                      Click="OpenSelectedHistoryPreviewMenuItem_Click" />
                            <Separator />
                            <MenuItem Header="左へ入力"
                                      Click="ReuseToLeftInputMenuItem_Click" />
                            <MenuItem Header="左へ送信"
                                      Click="ReuseToLeftSubmitMenuItem_Click" />
                            <MenuItem Header="右へ入力"
                                      Click="ReuseToRightInputMenuItem_Click" />
                            <MenuItem Header="右へ送信"
                                      Click="ReuseToRightSubmitMenuItem_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,2,2,2">
                                <TextBlock Text="{Binding Direction}"
                                           FontWeight="Bold"
                                           FontSize="11" />
                                <TextBlock Text="{Binding PreviewText}"
                                           TextWrapping="Wrap"
                                           MaxHeight="48"
                                           FontSize="10"
                                           Foreground="#555555" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TimestampText}"
                                               FontSize="9"
                                               Foreground="#888888" />
                                    <TextBlock Text=" | " FontSize="9" Foreground="#AAAAAA" />
                                    <TextBlock Text="{Binding ApprovalStatus}"
                                               FontSize="9"
                                               Foreground="#888888" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- Row 3: ステータスバー -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="#F0F0F0"
                BorderBrush="#CCCCCC"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <TextBlock x:Name="StatusTextBlock"
                       Text="準備中..."
                       FontSize="11"
                       Foreground="#333333"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
