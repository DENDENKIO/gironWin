<Window x:Class="gironWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="gironWin" Height="900" Width="1600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="8" Background="#F3F3F3">
            <WrapPanel Orientation="Horizontal">
                <TextBox x:Name="LeftUrlTextBox"
                         Width="280"
                         Margin="0,0,8,8"
                         VerticalContentAlignment="Center"
                         Text="https://www.perplexity.ai/" />

                <Button x:Name="LeftGoButton"
                        Width="80"
                        Margin="0,0,8,8"
                        Content="左へ移動"
                        Click="LeftGoButton_Click"/>

                <TextBox x:Name="RightUrlTextBox"
                         Width="280"
                         Margin="0,0,8,8"
                         VerticalContentAlignment="Center"
                         Text="https://gemini.google.com/app?hl=ja" />

                <Button x:Name="RightGoButton"
                        Width="80"
                        Margin="0,0,16,8"
                        Content="右へ移動"
                        Click="RightGoButton_Click"/>

                <CheckBox x:Name="AppendBridgeCheckBox"
                          Margin="0,4,12,8"
                          VerticalAlignment="Center"
                          IsChecked="True"
                          Content="橋渡し文を付ける" />

                <CheckBox x:Name="ConfirmBeforeSendCheckBox"
                          Margin="0,4,12,8"
                          VerticalAlignment="Center"
                          IsChecked="False"
                          Content="送信前確認" />

                <Button x:Name="SendLeftSelectionToRightInputButton"
                        Width="120"
                        Margin="0,0,8,8"
                        Content="左→右入力"
                        Click="SendLeftSelectionToRightInputButton_Click"/>

                <Button x:Name="SendLeftSelectionToRightSubmitButton"
                        Width="120"
                        Margin="0,0,8,8"
                        Content="左→右送信"
                        Click="SendLeftSelectionToRightSubmitButton_Click"/>

                <Button x:Name="SendRightSelectionToLeftInputButton"
                        Width="120"
                        Margin="0,0,8,8"
                        Content="右→左入力"
                        Click="SendRightSelectionToLeftInputButton_Click"/>

                <Button x:Name="SendRightSelectionToLeftSubmitButton"
                        Width="120"
                        Margin="0,0,8,8"
                        Content="右→左送信"
                        Click="SendRightSelectionToLeftSubmitButton_Click"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <wv2:WebView2 x:Name="LeftWebView" Grid.Column="0" />
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>
            <wv2:WebView2 x:Name="RightWebView" Grid.Column="2" />
        </Grid>
        <GridSplitter Grid.Row="2"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Rows"
                      Background="#D0D0D0"/>

        <Border Grid.Row="3"
                Margin="8,0,8,8"
                Padding="8"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="6"
                Background="#FAFAFA">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="送信履歴"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />

                    <Button Content="履歴クリア"
                            Width="100"
                            Margin="12,0,0,0"
                            Click="ClearHistoryButton_Click"/>
                </DockPanel>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding TransferRecords}"
                          x:Name="TransferHistoryListView"
                          MouseDoubleClick="TransferHistoryListView_MouseDoubleClick">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="全文コピー" Click="CopySelectedHistoryTextMenuItem_Click"/>
                            <MenuItem Header="詳細表示" Click="OpenSelectedHistoryPreviewMenuItem_Click"/>
                            <Separator/>
                            <MenuItem Header="左へ入力" Click="ReuseToLeftInputMenuItem_Click"/>
                            <MenuItem Header="左へ送信" Click="ReuseToLeftSubmitMenuItem_Click"/>
                            <MenuItem Header="右へ入力" Click="ReuseToRightInputMenuItem_Click"/>
                            <MenuItem Header="右へ送信" Click="ReuseToRightSubmitMenuItem_Click"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}">
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="時刻" Width="150" DisplayMemberBinding="{Binding TimestampText}" />
                            <GridViewColumn Header="方向" Width="180" DisplayMemberBinding="{Binding Direction}" />
                            <GridViewColumn Header="送信種別" Width="90" DisplayMemberBinding="{Binding SubmittedText}" />
                            <GridViewColumn Header="状態" Width="110" DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Header="内容" Width="850" DisplayMemberBinding="{Binding PreviewText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Margin="8,0,8,8"
                Padding="6,2"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="4"
                Background="#F5F5F5">
            <DockPanel>
                <TextBlock Text="状態:"
                           FontWeight="Bold"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusTextBlock"
                           Text="準備完了"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
