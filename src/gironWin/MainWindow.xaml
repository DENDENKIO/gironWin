<Window x:Class="gironWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="gironWin" Height="900" Width="1400"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#D32F2F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =========================================================
             メニューバー
        ========================================================= -->
        <Menu Grid.Row="0">
            <MenuItem Header="ファイル">
                <MenuItem Header="ログをエクスポート" Click="MenuExportLog_Click"/>
                <Separator/>
                <MenuItem Header="終了" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="討論">
                <MenuItem x:Name="MenuPreset" Header="プリセット選択..." Click="MenuPreset_Click"/>
                <MenuItem x:Name="MenuRoleSettings" Header="⚙ ロール設定(_R)" Click="MenuRoleSettings_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuIntervention" Header="✋ 介入(_I)" Click="MenuIntervention_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuResearchNote" Header="研究ノートを表示" Click="MenuResearchNote_Click" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="表示">
                <MenuItem Header="ログパネルを表示/非表示" Click="MenuToggleLog_Click"/>
            </MenuItem>
            <MenuItem Header="開発">
                <MenuItem Header="⚙ デバッグログ" Click="MenuDebugLog_Click"/>
            </MenuItem>
        </Menu>

        <!-- =========================================================
             ツールバー (討論制御)
        ========================================================= -->
        <Border Grid.Row="1" Background="#F0F0F0" BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <WrapPanel Margin="8,6" VerticalAlignment="Center">

                <!-- 左席URL -->
                <TextBlock Text="左席:" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="Bold"/>
                <TextBox x:Name="LeftUrlTextBox" Width="200" Margin="0,0,8,0"
                         Text="https://www.perplexity.ai/" VerticalContentAlignment="Center"/>

                <!-- 右席URL -->
                <TextBlock Text="右席:" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="Bold"/>
                <TextBox x:Name="RightUrlTextBox" Width="200" Margin="0,0,8,0"
                         Text="https://gemini.google.com/" VerticalContentAlignment="Center"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>

                <!-- 最大ターン -->
                <TextBlock Text="最大ターン:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="MaxTurnsTextBox" Width="45" Text="10" VerticalContentAlignment="Center" Margin="0,0,8,0"/>

                <!-- 承認モード -->
                <CheckBox x:Name="RequireApprovalCheckBox" Content="承認制" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,8,0"/>

                <!-- ブリッジ -->
                <CheckBox x:Name="AppendBridgeCheckBox" Content="橋渡し文" IsChecked="False"
                          VerticalAlignment="Center" Margin="0,0,8,0"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>

                <!-- 議題 -->
                <TextBlock Text="議題:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="TopicTextBox" Width="180" Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         ToolTip="エクスポート時の議題として使用されます"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>

                <!-- 開始/停止 -->
                <Button x:Name="StartButton" Content="▶ 開始" Style="{StaticResource PrimaryButton}"
                        Click="StartButton_Click" Margin="0,0,4,0"/>
                <Button x:Name="StopButton" Content="■ 停止" Style="{StaticResource DangerButton}"
                        Click="StopButton_Click" IsEnabled="False" Margin="0,0,4,0"/>
                <Button x:Name="PauseResumeButton" Content="⏸ 一時停止" Style="{StaticResource SecondaryButton}"
                        Click="PauseResumeButton_Click" IsEnabled="False" Margin="0,0,4,0"/>

                <!-- 介入ボタン -->
                <Button x:Name="InterventionButton" Content="✋ 介入"
                        Click="InterventionButton_Click" IsEnabled="False"
                        Margin="0,0,8,0" Padding="10,4"
                        Background="#5D4037" Foreground="White" BorderThickness="0" Cursor="Hand"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>

                <!-- プリセット表示 -->
                <TextBlock x:Name="CurrentPresetLabel" Text="(プリセット未選択)"
                           VerticalAlignment="Center" Foreground="#0078D4" FontStyle="Italic" Margin="4,0,8,0"/>

                <!-- プリセット選択ボタン -->
                <Button Content="📋 プリセット" Style="{StaticResource SecondaryButton}"
                        Click="MenuPreset_Click" Margin="0,0,4,0"/>

                <!-- 研究ノートボタン -->
                <Button x:Name="ResearchNoteButton" Content="🔬 研究ノート" Style="{StaticResource SecondaryButton}"
                        Click="MenuResearchNote_Click" IsEnabled="False" Margin="0,0,4,0"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>

                <!-- ★ ⚙ デバッグログボタン -->
                <Button x:Name="DebugLogButton" Content="⚙"
                        Click="DebugLogButton_Click"
                        Width="28" Height="24" FontSize="14"
                        Padding="0" Margin="0,0,0,0"
                        ToolTip="デバッグログを開く (往復カウント・送信履歴など)"
                        Background="#607D8B" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </WrapPanel>
        </Border>

        <!-- =========================================================
             第3席パネル
        ========================================================= -->
        <Expander Grid.Row="2" x:Name="ThirdSeatExpander"
                  Header="第3席 (司会・査読者)" IsExpanded="False"
                  Background="#FFF8E7" BorderBrush="#FFC107" BorderThickness="0,0,0,1"
                  Margin="0">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="モード:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold"/>
                <ComboBox Grid.Column="1" x:Name="ThirdSeatModeCombo" Width="100" Margin="0,0,12,0"
                          SelectionChanged="ThirdSeatModeCombo_SelectionChanged">
                    <ComboBoxItem Content="無効" Tag="Disabled" IsSelected="True"/>
                    <ComboBoxItem Content="人間" Tag="Human"/>
                    <ComboBoxItem Content="AI サイト" Tag="AiSite"/>
                </ComboBox>

                <TextBlock Grid.Column="2" Text="役割:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="3" x:Name="ThirdSeatRoleCombo" Width="110" Margin="0,0,12,0">
                    <ComboBoxItem Content="司会" Tag="Moderator" IsSelected="True"/>
                    <ComboBoxItem Content="査読者" Tag="Reviewer"/>
                    <ComboBoxItem Content="研究者" Tag="Researcher"/>
                    <ComboBoxItem Content="批判者" Tag="Critic"/>
                </ComboBox>

                <TextBlock Grid.Column="4" Text="介入間隔:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <TextBox x:Name="ThirdSeatIntervalTextBox" Width="40" Text="2"
                             VerticalContentAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="ターンごと" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <TextBlock Text="URL:" VerticalAlignment="Center" Margin="0,0,4,0"
                               x:Name="ThirdSeatUrlLabel" Visibility="Collapsed"/>
                    <TextBox x:Name="ThirdSeatUrlTextBox" Width="220"
                             VerticalContentAlignment="Center" Margin="0,0,12,0"
                             Visibility="Collapsed"
                             ToolTip="第3席として使うAIサイトのURL"/>

                    <TextBlock Text="表示名:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="ThirdSeatNameTextBox" Width="80" Text="第3席"
                             VerticalContentAlignment="Center" Margin="0,0,12,0"/>

                    <CheckBox x:Name="ResearchModeCheckBox" Content="🔬 研究モード" IsChecked="False"
                              VerticalAlignment="Center" Margin="0,0,8,0"
                              Checked="ResearchModeCheckBox_Changed" Unchecked="ResearchModeCheckBox_Changed"/>
                </StackPanel>
            </Grid>
        </Expander>

        <!-- =========================================================
             メインコンテンツ: WebView 左右 + ログパネル
        ========================================================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition x:Name="LogColumn" Width="280" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- 左席 WebView -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#E3F2FD" Padding="6,3">
                    <TextBlock x:Name="LeftSiteLabel" Text="左席: Perplexity"
                               FontWeight="Bold" FontSize="12"/>
                </Border>
                <wv2:WebView2 Grid.Row="1" x:Name="LeftWebView"
                              Source="https://www.perplexity.ai/"
                              NavigationCompleted="WebView_NavigationCompleted"/>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DDD"/>

            <!-- 右席 WebView -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#E8F5E9" Padding="6,3">
                    <TextBlock x:Name="RightSiteLabel" Text="右席: Gemini"
                               FontWeight="Bold" FontSize="12"/>
                </Border>
                <wv2:WebView2 Grid.Row="1" x:Name="RightWebView"
                              Source="https://gemini.google.com/"
                              NavigationCompleted="WebView_NavigationCompleted"/>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#DDD"/>

            <!-- ログパネル -->
            <Grid Grid.Column="4" x:Name="LogPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#F3E5F5" Padding="6,3">
                    <TextBlock Text="討論ログ" FontWeight="Bold" FontSize="12"/>
                </Border>
                <ListBox Grid.Row="1" x:Name="TurnLogListBox"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="TurnLogListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4,3" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TurnNumber, StringFormat='T{0}'}"
                                                   FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Direction}" FontSize="10" Foreground="#888"/>
                                        <TextBlock Text="{Binding ApprovalStatusDisplay}" Margin="4,0,0,0" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                               FontSize="11" Foreground="#333" MaxWidth="240"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- =========================================================
             承認パネル
        ========================================================= -->
        <Border Grid.Row="4" x:Name="ApprovalPanel"
                Background="#FFF9C4" BorderBrush="#FBC02D" BorderThickness="0,1,0,1"
                Visibility="Collapsed">
            <Grid Margin="8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ApprovalTitleLabel" Text="承認待ち:"
                               FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="ApprovalDirectionLabel" Text="" FontSize="11" Foreground="#666"/>
                </StackPanel>

                <TextBox Grid.Column="1" x:Name="ApprovalTextBox"
                         TextWrapping="Wrap" MaxHeight="80" MinHeight="40"
                         VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True" FontSize="12"
                         VerticalContentAlignment="Top" Padding="4"/>

                <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Button Content="✔ 承認" Style="{StaticResource PrimaryButton}"
                            Click="ApproveButton_Click" Margin="0,0,0,4"/>
                    <Button Content="✘ 却下" Style="{StaticResource DangerButton}"
                            Click="RejectButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =========================================================
             ステータスバー
        ========================================================= -->
        <StatusBar Grid.Row="5" Background="#ECEFF1">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="準備完了" FontSize="11"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="TurnCountLabel" Text="往復: 0" FontSize="11"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="PolicyLabel" Text="Policy: RoundRobin" FontSize="11" Foreground="#555"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem x:Name="ResearchStatusItem" Visibility="Collapsed">
                <TextBlock x:Name="ResearchTagCountLabel" Text="🔬 タグ: 0" FontSize="11" Foreground="DarkOrange"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
