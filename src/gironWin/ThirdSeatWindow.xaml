<Window x:Class="gironWin.ThirdSeatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x7b2c;3&#x5e2d; &#x2014; &#x4ecb;&#x5165;&#x5165;&#x529b;" Height="320" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Turn " FontWeight="SemiBold"/>
            <TextBlock x:Name="TurnLabel" FontWeight="SemiBold" Foreground="#0078D4"/>
            <TextBlock Text=" &#x2014; " Margin="4,0"/>
            <TextBlock x:Name="RoleLabel" Foreground="#666"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="ContextLabel"
                   TextWrapping="Wrap" Foreground="#444"
                   MaxHeight="80" Margin="0,0,0,8"
                   FontSize="11" Background="#F5F5F5"
                   Padding="6"/>

        <TextBox Grid.Row="2" x:Name="InputTextBox"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="13" Padding="6"
                 BorderBrush="#0078D4" BorderThickness="1"
                 Margin="0,0,0,8"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="&#x30B9;&#x30AD;&#x30C3;&#x30D7;" Width="90" Margin="0,0,8,0"
                    Click="SkipButton_Click"/>
            <Button Content="&#x9001;&#x4FE1;" Width="90"
                    Background="#0078D4" Foreground="White"
                    Click="SubmitButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
