<Window x:Class="gironWin.DebugLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:gironWin"
        Title="デバッグログ" Height="640" Width="1100"
        WindowStartupLocation="Manual"
        ResizeMode="CanResizeWithGrip"
        Background="#1E1E1E"
        Foreground="#D4D4D4"
        Closing="Window_Closing">

    <Window.Resources>

        <!-- ══ App.xaml の継承を BasedOn="{x:Null}" で完全遮断 ══ -->

        <!-- TextBlock -->
        <Style TargetType="TextBlock" BasedOn="{x:Null}">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo UI, Segoe UI, sans-serif"/>
        </Style>

        <!-- CheckBox（Content文字色を確実に制御するため Template を完全定義） -->
        <Style TargetType="CheckBox" BasedOn="{x:Null}">
            <Setter Property="Foreground"        Value="#D4D4D4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,8,0"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- チェックボックス本体（枠＋チェックマーク） -->
                            <Border x:Name="CheckBorder"
                                    Width="14" Height="14"
                                    Background="#2D2D2D"
                                    BorderBrush="#666666"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 2 7 L 5 10 L 12 3"
                                      Stroke="#D4D4D4"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <!-- Content ラベル：Foreground を TemplateBinding で受け取る -->
                            <TextBlock x:Name="ContentText"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckBorder" Property="Background" Value="#1E7AC8"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#1E7AC8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="CheckBorder" Property="Background" Value="#2D2D2D"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#AAAAAA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ContentText" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="CheckBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox" BasedOn="{x:Null}">
            <Setter Property="Background"      Value="#2D2D2D"/>
            <Setter Property="Foreground"      Value="#D4D4D4"/>
            <Setter Property="BorderBrush"     Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush"      Value="#D4D4D4"/>
            <Setter Property="Padding"         Value="4,2"/>
            <Setter Property="FontFamily"      Value="Yu Gothic UI, Meiryo UI, Segoe UI, sans-serif"/>
        </Style>

        <!-- Button（ダーク） BasedOn="{x:Null}" で App.xaml のテンプレートを遮断 -->
        <Style TargetType="Button" BasedOn="{x:Null}">
            <Setter Property="Background"      Value="#3C3C3C"/>
            <Setter Property="Foreground"      Value="#D4D4D4"/>
            <Setter Property="BorderBrush"     Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="Margin"          Value="0,0,4,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="Yu Gothic UI, Meiryo UI, Segoe UI, sans-serif"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <!-- TextBlock に Foreground を明示 -->
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{TemplateBinding FontFamily}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#888888"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E7AC8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ログ行スタイル（レベル別色） -->
        <Style x:Key="LogRowStyle" TargetType="ListBoxItem" BasedOn="{x:Null}">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#808080"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Margin"          Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static local:LogLevel.Info}">
                    <Setter Property="Foreground" Value="#D4D4D4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static local:LogLevel.Warn}">
                    <Setter Property="Background" Value="#1E1A00"/>
                    <Setter Property="Foreground" Value="#FFD700"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static local:LogLevel.Error}">
                    <Setter Property="Background" Value="#2A0000"/>
                    <Setter Property="Foreground" Value="#FF6B6B"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A2A"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <DockPanel Background="#1E1E1E" LastChildFill="True">

        <!-- ══ フィルタバー（ToolBar を廃止 → Border + WrapPanel） ══ -->
        <Border DockPanel.Dock="Top"
                Background="#252526"
                BorderBrush="#3C3C3C"
                BorderThickness="0,0,0,1"
                Padding="6,5">
            <WrapPanel Orientation="Horizontal">

                <!-- レベル -->
                <TextBlock Text="レベル:" Foreground="#888888"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <CheckBox x:Name="ChkDebug"  Content="DEBUG"
                          Foreground="#808080"
                          IsChecked="True"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="ChkInfo"   Content="INFO"
                          Foreground="#D4D4D4"
                          IsChecked="True"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="ChkWarn"   Content="WARN"
                          Foreground="#FFD700"
                          IsChecked="True"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="ChkError"  Content="ERROR"
                          Foreground="#FF6B6B"
                          IsChecked="True"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>

                <!-- 区切り -->
                <Rectangle Width="1" Fill="#444" Margin="8,2" VerticalAlignment="Stretch"/>

                <!-- カテゴリ -->
                <TextBlock Text="カテゴリ:" Foreground="#888888"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <CheckBox x:Name="ChkRunLoop"  Content="RunLoop"
                          Foreground="#7EC8E3"
                          IsChecked="True"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="ChkTurn"     Content="Turn"
                          Foreground="#7EC8E3"
                          IsChecked="True"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="ChkMonitor"  Content="Monitor"
                          Foreground="#B8E0B8"
                          IsChecked="True"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="ChkTransfer" Content="Transfer"
                          Foreground="#E8C87E"
                          IsChecked="True"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="ChkAdapter"  Content="Adapter"
                          Foreground="#E8A87E"
                          IsChecked="True"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="ChkApproval" Content="Approval"
                          Foreground="#D8A8D8"
                          IsChecked="True"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="ChkSession"  Content="Session"
                          Foreground="#AAAAAA"
                          IsChecked="True"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="ChkResearch" Content="Research"
                          Foreground="#A8D8A8"
                          IsChecked="True"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="ChkSystem"   Content="System"
                          Foreground="#AAAAAA"
                          IsChecked="True"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>

                <!-- 区切り -->
                <Rectangle Width="1" Fill="#444" Margin="8,2" VerticalAlignment="Stretch"/>

                <!-- 検索 -->
                <TextBlock Text="検索:" Foreground="#888888"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="FilterTextBox" Width="150"
                         TextChanged="FilterTextBox_TextChanged"/>

                <!-- 区切り -->
                <Rectangle Width="1" Fill="#444" Margin="8,2" VerticalAlignment="Stretch"/>

                <!-- 自動スクロール -->
                <CheckBox x:Name="AutoScrollCheckBox" Content="自動スクロール"
                          IsChecked="True"/>

                <!-- 区切り -->
                <Rectangle Width="1" Fill="#444" Margin="8,2" VerticalAlignment="Stretch"/>

                <!-- ボタン群 -->
                <Button x:Name="CopyFilteredButton" Content="表示行コピー"
                        Click="CopyFilteredButton_Click"/>
                <Button x:Name="CopySelectedButton" Content="選択行コピー"
                        Click="CopySelectedButton_Click"/>
                <Button x:Name="CopyAllButton"      Content="全コピー"
                        Click="CopyAllButton_Click"/>
                <Button x:Name="ClearButton"        Content="クリア"
                        Click="ClearButton_Click"/>
                <Button x:Name="SaveButton"         Content="保存"
                        Click="SaveButton_Click"/>

            </WrapPanel>
        </Border>

        <!-- ══ ステータスバー ══ -->
        <Border DockPanel.Dock="Bottom"
                Background="#252526"
                BorderBrush="#3C3C3C"
                BorderThickness="0,1,0,0"
                Padding="8,3">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TotalLinesLabel"  Text="ログ: 0 行"
                           Foreground="#888888" Margin="0,0,12,0"/>
                <Rectangle Width="1" Fill="#444" Margin="0,2"/>
                <TextBlock x:Name="FilteredLabel"    Text="表示: 0 行"
                           Foreground="#888888" Margin="12,0"/>
                <Rectangle Width="1" Fill="#444" Margin="0,2"/>
                <TextBlock x:Name="ErrorCountLabel"  Text="ERROR: 0"
                           Foreground="#FF6B6B" Margin="12,0,8,0"/>
                <TextBlock x:Name="WarnCountLabel"   Text="WARN: 0"
                           Foreground="#FFD700" Margin="0,0,12,0"/>
                <Rectangle Width="1" Fill="#444" Margin="0,2"/>
                <TextBlock x:Name="TurnCountLabel"   Text="ターン: 0"
                           Foreground="#888888" Margin="12,0,8,0"/>
                <TextBlock x:Name="RoundCountLabel"  Text="往復: 0"
                           Foreground="#888888"/>
            </StackPanel>
        </Border>

        <!-- ══ ログ一覧（SelectionMode=Extended で複数選択可） ══ -->
        <ListBox x:Name="LogListBox"
                 Background="#1E1E1E"
                 Foreground="#D4D4D4"
                 BorderThickness="0"
                 FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                 FontSize="11"
                 SelectionMode="Extended"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ItemContainerStyle="{StaticResource LogRowStyle}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding FormattedLine}"
                               TextWrapping="NoWrap"
                               Padding="6,1"
                               FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                               Foreground="{Binding RelativeSource={RelativeSource
                                   AncestorType=ListBoxItem}, Path=Foreground}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
