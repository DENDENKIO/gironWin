<Window x:Class="gironWin.PresetSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="プリセット選択" Height="480" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="PresetListBox" Grid.Row="0"
                 SelectionChanged="PresetListBox_SelectionChanged"
                 Margin="0,0,0,8" FontSize="13"/>

        <TextBlock x:Name="DescriptionTextBlock" Grid.Row="1"
                   TextWrapping="Wrap" Foreground="#555"
                   Margin="0,0,0,12" MinHeight="40"/>

        <!-- カスタム操作ボタン -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="＋ 新規作成" Width="100" Click="NewButton_Click" Padding="6,4" Margin="0,0,8,0"/>
            <Button x:Name="EditButton" Content="✎ 編集" Width="80"
                    Click="EditButton_Click" Padding="6,4" IsEnabled="False" Margin="0,0,8,0"/>
            <Button x:Name="DeleteButton" Content="🗑 削除" Width="80"
                    Click="DeleteButton_Click" Padding="6,4" IsEnabled="False"/>
        </StackPanel>

        <!-- 選択 / キャンセル -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="キャンセル" Width="90" IsCancel="True"
                    Click="CancelButton_Click" Padding="6,4" Margin="0,0,8,0"/>
            <Button Content="✔ 選択" Width="90" IsDefault="True"
                    Click="SelectButton_Click" Padding="6,4"
                    Background="#1976D2" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
