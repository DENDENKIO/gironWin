<Window x:Class="gironWin.PresetSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="討論プリセット選択" Height="460" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="討論プリセットを選択してください"
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

        <ListBox Grid.Row="1" x:Name="PresetListBox"
                 SelectionChanged="PresetListBox_SelectionChanged"
                 Margin="0,0,0,8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="{Binding TurnPolicyDescription}" FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 説明エリア -->
        <GroupBox Grid.Row="2" Header="プリセット詳細" Margin="0,0,0,8">
            <StackPanel Margin="4">
                <TextBlock x:Name="LeftPromptText"  TextWrapping="Wrap" FontSize="11" Margin="0,2"/>
                <TextBlock x:Name="RightPromptText" TextWrapping="Wrap" FontSize="11" Margin="0,2"/>
                <TextBlock x:Name="ResearchModeText" FontSize="11" Foreground="DarkOrange" Margin="0,2"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="キャンセル" Width="90" Margin="0,0,8,0"
                    Click="CancelButton_Click"/>
            <Button Content="適用" Width="90" IsDefault="True"
                    Background="#0078D4" Foreground="White"
                    Click="ApplyButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
