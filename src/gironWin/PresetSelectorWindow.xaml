<Window x:Class="gironWin.PresetSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x30D7;&#x30EA;&#x30BB;&#x30C3;&#x30C8;&#x9078;&#x629E;" Height="400" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="&#x8A0E;&#x8AD6;&#x30D7;&#x30EA;&#x30BB;&#x30C3;&#x30C8;&#x3092;&#x9078;&#x629E;&#x3057;&#x3066;&#x304F;&#x3060;&#x3055;&#x3044;"
                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <ListBox Grid.Row="1" x:Name="PresetListBox"
                 SelectionChanged="PresetListBox_SelectionChanged"
                 BorderBrush="#CCC" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="8,6">
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding Description}"
                                   Foreground="#666" FontSize="11"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Policy: " Foreground="#888" FontSize="11"/>
                            <TextBlock Text="{Binding TurnPolicy}"
                                       Foreground="#0078D4" FontSize="11"/>
                            <TextBlock Text="  &#x1F52C;&#x7814;&#x7A76;&#x30E2;&#x30FC;&#x30C9;" FontSize="11"
                                       Foreground="#E67E22"
                                       Visibility="{Binding ResearchMode,
                                           Converter={StaticResource BoolToVisConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" x:Name="DescriptionLabel"
                   Margin="0,8,0,8" FontSize="11"
                   Foreground="#555" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="&#x30AD;&#x30E3;&#x30F3;&#x30BB;&#x30EB;" Width="90" Margin="0,0,8,0"
                    Click="CancelButton_Click"/>
            <Button Content="&#x9069;&#x7528;" Width="90" IsDefault="True"
                    x:Name="ApplyButton" IsEnabled="False"
                    Click="ApplyButton_Click"
                    Background="#0078D4" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
