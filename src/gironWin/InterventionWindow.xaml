<Window x:Class="gironWin.InterventionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="途中介入"
        Width="680"
        Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="途中介入モード"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1"
                   Text="下記にテキストを入力し、送信先を選んで送信するか、討論を再開するか選んでください。"
                   TextWrapping="Wrap"
                   Foreground="Gray"
                   FontSize="12"
                   Margin="0,0,0,10"/>

        <TextBox Grid.Row="2"
                 x:Name="InterventionTextBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Meiryo UI, sans-serif"
                 FontSize="13"
                 Padding="8"
                 BorderBrush="#c0c0c0"
                 BorderThickness="1"/>

        <!-- 送信先選択 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="送信先:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <RadioButton x:Name="SendLeftRadio"
                         Content="左席（Left）"
                         IsChecked="True"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0"/>
            <RadioButton x:Name="SendRightRadio"
                         Content="右席（Right）"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0"/>
            <RadioButton x:Name="SendBothRadio"
                         Content="両方"
                         VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ボタン行 -->
        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <Button Content="討論を再開（送信せず）"
                    Width="140"
                    DockPanel.Dock="Left"
                    Click="ResumeOnlyButton_Click"/>
            <Button Content="キャンセル"
                    Width="90"
                    DockPanel.Dock="Right"
                    Margin="8,0,0,0"
                    Click="CancelButton_Click"/>
            <Button Content="送信して再開"
                    Width="120"
                    DockPanel.Dock="Right"
                    Background="#1a6e8a"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="SendAndResumeButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
