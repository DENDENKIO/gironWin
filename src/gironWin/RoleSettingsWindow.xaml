<Window x:Class="gironWin.RoleSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="役割設定"
        Width="600"
        Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="左右各AIの役割・インストラクションを設定します。送信文の先頭に自動付加されます。"
                   TextWrapping="Wrap"
                   Foreground="Gray"
                   FontSize="12"
                   Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 左席 -->
                <GroupBox Header="左席（Left AI）" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="プリセット:" Width="70" VerticalAlignment="Center"/>
                            <ComboBox x:Name="LeftPresetCombo"
                                      Width="200"
                                      SelectionChanged="LeftPresetCombo_SelectionChanged"/>
                        </StackPanel>
                        <TextBlock Text="インストラクション:" Margin="0,0,0,4"/>
                        <TextBox x:Name="LeftPromptTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="100"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="12"
                                 Padding="6"/>
                    </StackPanel>
                </GroupBox>

                <!-- 右席 -->
                <GroupBox Header="右席（Right AI）" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="プリセット:" Width="70" VerticalAlignment="Center"/>
                            <ComboBox x:Name="RightPresetCombo"
                                      Width="200"
                                      SelectionChanged="RightPresetCombo_SelectionChanged"/>
                        </StackPanel>
                        <TextBlock Text="インストラクション:" Margin="0,0,0,4"/>
                        <TextBox x:Name="RightPromptTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="100"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="12"
                                 Padding="6"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- ボタン -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button Content="キャンセル"
                    Width="90"
                    DockPanel.Dock="Right"
                    Margin="8,0,0,0"
                    Click="CancelButton_Click"/>
            <Button Content="OK"
                    Width="90"
                    DockPanel.Dock="Right"
                    Background="#1a6e8a"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="OkButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
