<Window x:Class="gironWin.RoleSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x5f79;&#x5272;&#x8a2d;&#x5b9a;"
        Width="620"
        Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="&#x5de6;&#x53f3;&#x5404;AI&#x306e;&#x5f79;&#x5272;&#x30fb;&#x30a4;&#x30f3;&#x30b9;&#x30c8;&#x30e9;&#x30af;&#x30b7;&#x30e7;&#x30f3;&#x3092;&#x8a2d;&#x5b9a;&#x3057;&#x307e;&#x3059;&#x3002;"
                   TextWrapping="Wrap"
                   Foreground="Gray"
                   FontSize="12"
                   Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- &#x30d7;&#x30ea;&#x30bb;&#x30c3;&#x30c8;&#x9078;&#x629e; -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="&#x30d7;&#x30ea;&#x30bb;&#x30c3;&#x30c8;:" Width="80" VerticalAlignment="Center" FontWeight="Bold"/>
                    <ComboBox x:Name="ProfileComboBox" Width="200"
                              SelectionChanged="ProfileComboBox_SelectionChanged">
                        <ComboBoxItem Content="&#x30ab;&#x30b9;&#x30bf;&#x30e0;" IsSelected="True"/>
                        <ComboBoxItem Content="&#x8a0e;&#x8ad6;&#xff08;&#x63d0;&#x6848; vs &#x6279;&#x5224;&#xff09;"/>
                        <ComboBoxItem Content="&#x7814;&#x7a76;&#xff08;&#x4eee;&#x8aac; vs &#x8a3c;&#x660e;&#xff09;"/>
                        <ComboBoxItem Content="&#x67fb;&#x8aad;&#xff08;&#x8457;&#x8005; vs &#x67fb;&#x8aad;&#x8005;&#xff09;"/>
                    </ComboBox>
                </StackPanel>

                <!-- &#x8b70;&#x984c; -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="&#x8b70;&#x984c;:" Width="80" VerticalAlignment="Center"/>
                    <TextBox x:Name="TopicTextBox" Width="400" Padding="4,2"/>
                </StackPanel>

                <!-- &#x5de6;&#x5e2d; -->
                <GroupBox Header="&#x5de6;&#x5e2d;&#xff08;Left AI&#xff09;" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#x8868;&#x793a;&#x540d;:" Width="70" VerticalAlignment="Center"/>
                            <TextBox x:Name="LeftNameTextBox" Width="180" Padding="4,2"/>
                        </StackPanel>
                        <TextBlock Text="&#x30a4;&#x30f3;&#x30b9;&#x30c8;&#x30e9;&#x30af;&#x30b7;&#x30e7;&#x30f3;:" Margin="0,0,0,4"/>
                        <TextBox x:Name="LeftPromptTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="80"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="12"
                                 Padding="6"/>
                    </StackPanel>
                </GroupBox>

                <!-- &#x53f3;&#x5e2d; -->
                <GroupBox Header="&#x53f3;&#x5e2d;&#xff08;Right AI&#xff09;" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#x8868;&#x793a;&#x540d;:" Width="70" VerticalAlignment="Center"/>
                            <TextBox x:Name="RightNameTextBox" Width="180" Padding="4,2"/>
                        </StackPanel>
                        <TextBlock Text="&#x30a4;&#x30f3;&#x30b9;&#x30c8;&#x30e9;&#x30af;&#x30b7;&#x30e7;&#x30f3;:" Margin="0,0,0,4"/>
                        <TextBox x:Name="RightPromptTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="80"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="12"
                                 Padding="6"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- &#x30dc;&#x30bf;&#x30f3; -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button Content="&#x30ad;&#x30e3;&#x30f3;&#x30bb;&#x30eb;"
                    Width="90"
                    DockPanel.Dock="Right"
                    Margin="8,0,0,0"
                    Click="CancelButton_Click"/>
            <Button Content="OK"
                    Width="90"
                    DockPanel.Dock="Right"
                    Background="#1a6e8a"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="OkButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
