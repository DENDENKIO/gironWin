<Window x:Class="gironWin.TextPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="[Legacy] 生成文章ログリーダー" Height="600" Width="800" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="PrevButton" Content="← 前へ" Width="80" Margin="0,0,10,0" Click="PrevButton_Click"/>
            <TextBlock x:Name="PageInfoLabel" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="NextButton" Content="次へ →" Width="80" Click="NextButton_Click"/>
            <TextBlock x:Name="HeaderLabel" VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="Bold"/>
        </StackPanel>

        <RichTextBox x:Name="FullTextBox" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontSize="14" Padding="10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="全文コピー" Width="100" Margin="0,0,10,0" Click="CopyButton_Click"/>
            <Button Content="閉じる" Width="80" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>