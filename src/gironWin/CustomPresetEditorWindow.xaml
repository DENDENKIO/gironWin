<Window x:Class="gironWin.CustomPresetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="カスタムプリセット編集" Height="560" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 名前 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="プリセット名:" Width="110" VerticalAlignment="Center"/>
            <TextBox x:Name="NameBox" Padding="4,2"/>
        </DockPanel>

        <!-- 説明 -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="説明:" Width="110" VerticalAlignment="Center"/>
            <TextBox x:Name="DescBox" Padding="4,2"/>
        </DockPanel>

        <!-- ポリシー + 研究モード -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="TurnPolicy:" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <ComboBox x:Name="PolicyCombo" Width="200" Margin="0,0,16,0">
                <ComboBoxItem Tag="RoundRobin"         Content="RoundRobin（交互）" IsSelected="True"/>
                <ComboBoxItem Tag="CritiqueThenRefine" Content="CritiqueThenRefine（批判→改善）"/>
                <ComboBoxItem Tag="ResearchReviewLoop" Content="ResearchReviewLoop（研究）"/>
                <ComboBoxItem Tag="ModeratorSelect"    Content="ModeratorSelect（司会）"/>
                <ComboBoxItem Tag="HumanPriority"      Content="HumanPriority（人間割り込み）"/>
            </ComboBox>
            <CheckBox x:Name="ResearchCheckBox" Content="研究モード" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 左席プロンプト -->
        <GroupBox Grid.Row="3" Header="左席 システムプロンプト" Margin="0,0,0,6">
            <TextBox x:Name="LeftPromptBox" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" Padding="4"/>
        </GroupBox>

        <!-- 右席プロンプト -->
        <GroupBox Grid.Row="4" Header="右席 システムプロンプト" Margin="0,0,0,6">
            <TextBox x:Name="RightPromptBox" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" Padding="4"/>
        </GroupBox>

        <!-- 議題 -->
        <DockPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Text="議題:" Width="110" VerticalAlignment="Center"/>
            <TextBox x:Name="TopicBox" Padding="4,2"/>
        </DockPanel>

        <!-- ボタン -->
        <StackPanel Grid.Row="6" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="キャンセル" Width="90" IsCancel="True"
                    Click="CancelButton_Click" Padding="6,4" Margin="0,0,8,0"/>
            <Button Content="💾 保存" Width="90" IsDefault="True"
                    Click="SaveButton_Click" Padding="6,4"
                    Background="#388E3C" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
